# Copy this file to .env.qa.local (it is ignored by git: never commit it).
# It configures the QA suite that tests the REAL Firebase backend
# (docs/qa/firebase-real.md). Use a separate TEST project if you can.

# Firebase web config of the project to test (Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Safety lock: must equal VITE_FIREBASE_PROJECT_ID exactly, or nothing runs
QA_FIREBASE_ALLOW_PROJECT=

# Most writes one run may make (the free plan allows 20000 a day). Default 400
QA_MAX_WRITES=400

# Optional: a fixed id for the run (3-30 letters, digits, "-"). Default: date and time
QA_RUN_ID=

# Test accounts, made by a person in the console (Authentication > Users >
# Add user). At least 2 are needed (1 and 2); up to 15. The suite only signs
# in: it never creates or deletes accounts.
QA_ACCOUNT_1_EMAIL=
QA_ACCOUNT_1_PASSWORD=
QA_ACCOUNT_2_EMAIL=
QA_ACCOUNT_2_PASSWORD=
QA_ACCOUNT_3_EMAIL=
QA_ACCOUNT_3_PASSWORD=
QA_ACCOUNT_4_EMAIL=
QA_ACCOUNT_4_PASSWORD=
QA_ACCOUNT_5_EMAIL=
QA_ACCOUNT_5_PASSWORD=
QA_ACCOUNT_6_EMAIL=
QA_ACCOUNT_6_PASSWORD=
QA_ACCOUNT_7_EMAIL=
QA_ACCOUNT_7_PASSWORD=
QA_ACCOUNT_8_EMAIL=
QA_ACCOUNT_8_PASSWORD=
QA_ACCOUNT_9_EMAIL=
QA_ACCOUNT_9_PASSWORD=
QA_ACCOUNT_10_EMAIL=
QA_ACCOUNT_10_PASSWORD=
QA_ACCOUNT_11_EMAIL=
QA_ACCOUNT_11_PASSWORD=
QA_ACCOUNT_12_EMAIL=
QA_ACCOUNT_12_PASSWORD=
QA_ACCOUNT_13_EMAIL=
QA_ACCOUNT_13_PASSWORD=
QA_ACCOUNT_14_EMAIL=
QA_ACCOUNT_14_PASSWORD=
QA_ACCOUNT_15_EMAIL=
QA_ACCOUNT_15_PASSWORD=
