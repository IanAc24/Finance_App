# Copy this file to .env.local (never commit .env.local) and fill in the
# values from the Firebase console: Project settings > Your apps > Web app.
# Vite reads them when the app is built (npm run dev / npm run build).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Sign-up (/registro) is open by default; "0" hides the page and its link
VITE_ALLOW_SIGNUP=
# Where each account's data lives: empty = Firestore (only that account sees
# it, in any browser). "local" goes back to the one SQLite database of this
# device, shared by every account (only to roll back if the cloud fails).
VITE_DATA_BACKEND=
